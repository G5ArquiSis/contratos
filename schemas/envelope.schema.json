{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/G5ArquiSis/contratos/schemas/envelope.schema.json",
  "title": "Envelope v3",
  "description": "Campos comunes a los mensajes del protocolo v3. Sin msgId o sin JSON parseable en colas punto a punto se descarta y registra; si faltan campos obligatorios se responde NACK.",
  "type": "object",
  "required": [
    "type"
  ],
  "properties": {
    "idpk": {
      "type": "string",
      "minLength": 1,
      "description": "Llave de idempotencia; igual en reintentos de la misma operación"
    },
    "msgId": {
      "type": "string",
      "minLength": 1,
      "description": "UUID nuevo en cada envío; las respuestas lo citan en data.target"
    },
    "type": {
      "enum": [
        "ack",
        "nack",
        "error",
        "status-statement",
        "transfer",
        "distance-table",
        "negotiation-report",
        "request",
        "offer",
        "offer-updated",
        "offer-withdrawn",
        "market-closed",
        "bid",
        "bid-accepted",
        "bid-rejected",
        "trade-recorded",
        "imbalance-settlement",
        "swap-proposed",
        "swap-settled",
        "swap-rejected",
        "swap-expired",
        "swap-cancelled",
        "demand-statement",
        "give",
        "take",
        "negotiation-proposal"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "cityId": {
      "type": "string",
      "pattern": "^[A-Z0-9]{3}$",
      "description": "code de la ciudad emisora"
    },
    "sender": {
      "const": "central",
      "description": "Lo llevan los mensajes emitidos por la central"
    },
    "cycleId": {
      "type": "string",
      "description": "Ciclo al que pertenece la operación"
    },
    "data": {
      "type": "object"
    }
  }
}
