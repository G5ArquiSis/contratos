{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/G5ArquiSis/contratos/schemas/transfer.schema.json",
  "title": "Transfer v3",
  "description": "Financiamiento de créditos otorgado por la central para el ciclo actual.",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "type": "object",
  "required": [
    "cycleId",
    "data"
  ],
  "properties": {
    "type": {
      "const": "transfer"
    },
    "data": {
      "type": "object",
      "required": [
        "quantity"
      ],
      "properties": {
        "quantity": {
          "type": "number",
          "description": "Monto neto en créditos transferido a la cuenta de la ciudad"
        },
        "balanceAfter": {
          "type": "number",
          "description": "Saldo en créditos resultante en la wallet tras el financiamiento y multa"
        },
        "creditLine": {
          "type": "number",
          "description": "Línea de crédito autorizada en la wallet (dos veces el financiamiento bruto)"
        },
        "penalty": {
          "description": "Multa descontada si hubo reporte tardío o no enviado en un ciclo previo",
          "oneOf": [
            {
              "type": "object",
              "required": [
                "amount",
                "forCycleId"
              ],
              "properties": {
                "amount": {
                  "type": "number",
                  "minimum": 0
                },
                "forCycleId": {
                  "type": "string"
                }
              }
            },
            {
              "type": "number",
              "minimum": 0
            }
          ]
        },
        "becauseOf": {
          "type": "string",
          "description": "msgId del evento que originó el pago (si aplica)"
        }
      }
    }
  }
}
