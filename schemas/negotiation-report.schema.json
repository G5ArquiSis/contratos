{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/G5ArquiSis/contratos/schemas/negotiation-report.schema.json",
  "title": "Negotiation-report",
  "description": "Balances del ciclo, enviados en el periodo de cierre de la ventana.",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "type": "object",
  "required": [
    "cityId",
    "cycleId",
    "data"
  ],
  "properties": {
    "type": {
      "const": "negotiation-report"
    },
    "data": {
      "type": "object",
      "required": [
        "budgetBalance",
        "energyBalance"
      ],
      "properties": {
        "budgetBalance": {
          "type": "number",
          "description": "Presupuesto acumulado, en créditos"
        },
        "energyBalance": {
          "type": "number",
          "description": "Balance de energía del ciclo, en kWh"
        }
      }
    }
  }
}
