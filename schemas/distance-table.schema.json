{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/G5ArquiSis/contratos/schemas/distance-table.schema.json",
  "title": "Distance-table v3",
  "description": "Tabla de distancias y costos de transporte hacia otras ciudades, con soporte para rutas deshabilitadas y penalización.",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "type": "object",
  "required": [
    "sender",
    "data"
  ],
  "properties": {
    "type": {
      "const": "distance-table"
    },
    "data": {
      "type": "object",
      "required": [
        "distances"
      ],
      "properties": {
        "disabledRouteTransportCost": {
          "type": "number",
          "minimum": 0,
          "description": "Tarifa punitiva por kWh·km aplicada al comprar por rutas con enabled: false"
        },
        "distances": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Z0-9]{3}$"
          },
          "additionalProperties": {
            "type": "object",
            "required": [
              "distance",
              "transportCost",
              "enabled"
            ],
            "properties": {
              "distance": {
                "type": "number",
                "minimum": 0,
                "description": "Distancia en metros"
              },
              "transportCost": {
                "type": "number",
                "minimum": 0,
                "description": "Costo en créditos por kWh·km"
              },
              "enabled": {
                "type": "boolean",
                "description": "False si la ruta fue temporalmente deshabilitada en el ciclo"
              }
            }
          }
        }
      }
    }
  }
}
