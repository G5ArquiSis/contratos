{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/G5ArquiSis/contratos/schemas/ack.schema.json",
  "title": "ACK",
  "description": "Confirma la recepción (no el contenido). Nunca se responde con ACK ni NACK.",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "type": "object",
  "required": [
    "data"
  ],
  "properties": {
    "type": {
      "const": "ack"
    },
    "data": {
      "type": "object",
      "required": [
        "target"
      ],
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1,
          "description": "msgId del mensaje respondido"
        }
      }
    }
  }
}
