{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/G5ArquiSis/contratos/schemas/error.schema.json",
  "title": "Error",
  "description": "Mensaje bien formado que la central no puede atender. Llega precedido de su ack.",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "type": "object",
  "required": [
    "sender",
    "reason",
    "code",
    "data"
  ],
  "properties": {
    "type": {
      "const": "error"
    },
    "reason": {
      "type": "string",
      "description": "Nombre del error, por ejemplo MALFORMED_MESSAGE"
    },
    "code": {
      "type": "integer",
      "description": "Código prestado de HTTP"
    },
    "data": {
      "type": "object",
      "required": [
        "target",
        "message"
      ],
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1,
          "description": "msgId del mensaje que causó el error"
        },
        "message": {
          "type": "string"
        },
        "spare": {
          "type": "number",
          "description": "Energía vendible restante, en OVER_CAPACITY"
        },
        "opensAt": {
          "type": "string",
          "format": "date-time",
          "description": "En REPORT_TOO_EARLY: cuándo abre el periodo de cierre"
        }
      }
    }
  }
}
